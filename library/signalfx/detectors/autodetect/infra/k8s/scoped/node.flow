from signalfx.detectors.autodetect import utils
from signalfx.detectors.autodetect.infra.k8s import utils as k8s_utils

# avoid MTS collision with other processes using the same metric name
NODE_FILTER = (filter(k8s_utils.K8S_CLUSTER_NAME_DIM, '*') and
               filter(k8s_utils.K8S_NODE_NAME_DIM, '*')
               and not filter('process.pid', '*')
               and not filter('k8s.pod.uid', '*'))


def node_cpu_utilization_detector(filter_: filter = None):
    # Detects when the node CPU utilization per cluster is high
    # :param filter_ description=Specifies dimensional scope of the detector
    # :param filter_ metric_name=cpu.utilization
    # :return: detect block that triggers when the node CPU utilization per cluster is high
    scope_filter = utils.merge_filters(NODE_FILTER, filter_)
    CPU = data('cpu.utilization', filter=scope_filter)
    TOTAL = CPU.count(by=k8s_utils.K8S_CLUSTER_NAME_DIM)
    CPU95 = CPU.above(95).count(by=k8s_utils.K8S_CLUSTER_NAME_DIM)
    CPU90 = CPU.above(90).count(by=k8s_utils.K8S_CLUSTER_NAME_DIM)
    CPU80 = CPU.above(80).count(by=k8s_utils.K8S_CLUSTER_NAME_DIM)
    CPU95_PCT = (CPU95 / TOTAL * 100.0)
    CPU90_PCT = (CPU90 / TOTAL * 100.0)
    CPU80_PCT = (CPU80 / TOTAL * 100.0)
    fire_threshold_stream = const(1.0)
    ann = [utils.annotate_stream(CPU95_PCT, 'CPU95_PCT'),
           utils.annotate_stream(CPU90_PCT, 'CPU90_PCT'),
           utils.annotate_stream(CPU80_PCT, 'CPU80_PCT'),
           utils.annotate_fire_threshold(fire_threshold_stream, orientation='above')]
    return detect((when(CPU95_PCT >= fire_threshold_stream, lasting=lasting('3m', 0.6)) or 
                   when(CPU90_PCT >= fire_threshold_stream, lasting=lasting('8m', 0.8)) or 
                   when(CPU80_PCT >= fire_threshold_stream, lasting=lasting('15m', 0.8))),
                  off=(when(CPU95_PCT < fire_threshold_stream, lasting=lasting('10m', 0.9)) and 
                       when(CPU90_PCT < fire_threshold_stream, lasting=lasting('15m', 0.9)) and 
                       when(CPU80_PCT < fire_threshold_stream, lasting=lasting('25m', 0.9))),
                  annotations=ann,
                  auto_resolve_after=duration('1d'))


def node_memory_utilization_detector(filter_: filter = None):
    # Detects when the node MEM utilization per cluster is high
    # :param filter_ description=Specifies dimensional scope of the detector
    # :param filter_ metric_name=memory.utilization
    # :return: detect block that triggers when the node MEM utilization per cluster is high
    scope_filter = utils.merge_filters(NODE_FILTER, filter_)
    MEM = data('memory.utilization', filter=scope_filter)
    TOTAL = MEM.count(by=k8s_utils.K8S_CLUSTER_NAME_DIM)
    MEM95 = MEM.above(95).count(by=k8s_utils.K8S_CLUSTER_NAME_DIM)
    MEM90 = MEM.above(90).count(by=k8s_utils.K8S_CLUSTER_NAME_DIM)
    MEM80 = MEM.above(80).count(by=k8s_utils.K8S_CLUSTER_NAME_DIM)
    MEM95_PCT = (MEM95 / TOTAL * 100.0)
    MEM90_PCT = (MEM90 / TOTAL * 100.0)
    MEM80_PCT = (MEM80 / TOTAL * 100.0)
    fire_threshold_stream = const(1.0)
    ann = [utils.annotate_stream(MEM95_PCT, 'MEM95_PCT'),
           utils.annotate_stream(MEM90_PCT, 'MEM90_PCT'),
           utils.annotate_stream(MEM80_PCT, 'MEM80_PCT'),
           utils.annotate_fire_threshold(fire_threshold_stream, orientation='above')]
    return detect((when(MEM95_PCT >= fire_threshold_stream, lasting=lasting('3m', 0.6)) or
                   when(MEM90_PCT >= fire_threshold_stream, lasting=lasting('8m', 0.8)) or 
                   when(MEM80_PCT >= fire_threshold_stream, lasting=lasting('15m', 0.8))),
                  off=(when(MEM95_PCT < fire_threshold_stream, lasting=lasting('10m', 0.9)) and 
                       when(MEM90_PCT < fire_threshold_stream, lasting=lasting('15m', 0.9)) and 
                       when(MEM80_PCT < fire_threshold_stream, lasting=lasting('25m', 0.9))),
                  annotations=ann,
                  auto_resolve_after=duration('1d'))


def node_readiness_detector(filter_: filter = None):
    # Detects when the percentage of ready nodes per cluster is below threshold
    # :param filter_ description=Specifies dimensional scope of the detector
    # :param filter_ metric_name=k8s.node.condition_ready
    # :return: detect block that triggers when the percentage of ready nodes per cluster is below threshold.
    # https://help.splunk.com/en/splunk-observability-cloud/manage-data/available-data-sources/supported-integrations-in-splunk-observability-cloud/applications-orchestration/kubernetes-cluster-receiver
    # NOTE: k8s.node.condition_ready is 1 if ready, 0 if not, -1 if unknown.
    _READY = data('k8s.node.condition_ready', filter=filter_)
    KUBERNETES_CLUSTER_DIM = "kubernetes_cluster"
    TOTAL = _READY.count(by=KUBERNETES_CLUSTER_DIM)
    READY = max(0, _READY).sum(by=KUBERNETES_CLUSTER_DIM)
    READY_PCT = (READY / TOTAL * 100.0)
    fire_threshold_stream_90 = const(90.0)
    fire_threshold_stream_95 = const(95.0)
    ann = [utils.annotate_stream(READY_PCT, 'READY_PCT'),
           utils.annotate_fire_threshold(fire_threshold_stream_90,
                                         label='90% readiness — 1 minute threshold',
                                         orientation='below'),
           utils.annotate_fire_threshold(fire_threshold_stream_95,
                                         label='95% readiness — 5 minutes threshold',
                                         orientation='below')]
    return detect((when(READY_PCT <= fire_threshold_stream_90, lasting=lasting('1m', 1.0)) or 
                   when(READY_PCT <= fire_threshold_stream_95, lasting=lasting('5m', 0.8))),
                  off=(when(READY_PCT > fire_threshold_stream_90, lasting=lasting('8m', 1.0)) and 
                       when(READY_PCT > fire_threshold_stream_95, lasting=lasting('15m', 0.8))),
                  annotations=ann,
                  auto_resolve_after=duration('3d'))
