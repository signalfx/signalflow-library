from signalfx.detectors.autodetect import utils
from signalfx.detectors.autodetect.infra.k8s import utils as k8s_utils


# avoid MTS collision with other processes using the same metric name
NODE_FILTER = (filter(k8s_utils.K8S_CLUSTER_NAME_DIM, '*') and
               filter(k8s_utils.K8S_NODE_NAME_DIM, '*')
               and not filter('process.pid', '*')
               and not filter('k8s.pod.uid', '*'))


def nodes_not_ready_detector(fire_lasting: lasting = lasting('5m', 0.9),
                             clear_lasting: lasting = lasting('10m', 1),
                             filter_: filter = None):
    # Detects when K8s Node is not in a Ready state for 5 minutes
    # :param fire_lasting description=Specifies the duration and percentage of the duration over which the alert condition must persist before the alert fires
    # :param fire_lasting label=Alert firing evaluation criteria
    # :param clear_lasting description=Specifies the duration and percentage of the duration over which the clear condition must persit before the alert is cleared.
    # :param clear_lasting label=Alert clearing evaluation criteria
    # :param filter_ description=Specifies dimensional scope of the detector
    # :param filter_ metric_name=k8s.node.condition_ready
    # :return: detect block that triggers when Node is not ready for 5 minutes
    group_by = [k8s_utils.K8S_CLUSTER_NAME_DIM, k8s_utils.K8S_NODE_NAME_DIM]
    stream = data('k8s.node.condition_ready', filter=filter_).sum(by=group_by)
    fire_threshold_stream = const(1)
    ann = [utils.annotate_stream(stream, 'Node condition ready'),
           utils.annotate_fire_threshold(fire_threshold_stream, orientation='below')]
    return detect(when(stream < fire_threshold_stream, lasting=fire_lasting),
                  off=when(stream == fire_threshold_stream, lasting=clear_lasting),
                  annotations=ann,
                  auto_resolve_after=utils.AUTO_RESOLVE_AFTER)


def node_memory_utilization_detector(fire_threshold: float = 90,
                                     fire_lasting: lasting = lasting('15m', 0.9),
                                     clear_lasting: lasting = lasting('20m', 1),
                                     filter_: filter = None):
    # Detects when K8s Node memory utilization is high
    # :param fire_threshold description=Specifies trigger threshold for memory utilization
    # :param fire_threshold label=Trigger threshold
    # :param fire_threshold unit=%
    # :param fire_lasting description=Specifies the duration and percentage of the duration over which the alert condition must persist before the alert fires
    # :param fire_lasting label=Alert firing evaluation criteria
    # :param clear_lasting description=Specifies the duration and percentage of the duration over which the clear condition must persit before the alert is cleared.
    # :param clear_lasting label=Alert clearing evaluation criteria 
    # :param filter_ description=Specifies dimensional scope of the detector
    # :param filter_ metric_name=memory.utilization
    # :viz valueSuffix=%
    # :return: detect block that triggers when Node memory utilization is above threshold
    scope_filter = utils.merge_filters(NODE_FILTER, filter_)
    group_by = [k8s_utils.K8S_CLUSTER_NAME_DIM, k8s_utils.K8S_NODE_NAME_DIM]
    stream = data('memory.utilization', filter=scope_filter).sum(by=group_by)
    fire_threshold_stream = const(fire_threshold)
    ann = [utils.annotate_stream(stream, 'Memory utilization'),
           utils.annotate_fire_threshold(fire_threshold_stream, orientation='above')]
    return detect(when(stream > fire_threshold_stream, lasting=fire_lasting),
                  off=when(stream <= fire_threshold_stream, lasting=clear_lasting),
                  annotations=ann,
                  auto_resolve_after=utils.AUTO_RESOLVE_AFTER)


def node_cpu_utilization_detector(fire_threshold: float = 90,
                                  fire_lasting: lasting = lasting('15m', 0.9),
                                  clear_lasting: lasting = lasting('20m', 1),
                                  filter_: filter = None):
    # Detects when K8s Node CPU utilization is high
    # :param fire_threshold description=Specifies trigger threshold for CPU utilization
    # :param fire_threshold label=Trigger threshold
    # :param fire_threshold unit=%
    # :param fire_lasting description=Specifies the duration and percentage of the duration over which the alert condition must persist before the alert fires
    # :param fire_lasting label=Alert firing evaluation criteria
    # :param clear_lasting description=Specifies the duration and percentage of the duration over which the clear condition must persit before the alert is cleared.
    # :param clear_lasting label=Alert clearing evaluation criteria 
    # :param filter_ description=Specifies dimensional scope of the detector
    # :param filter_ metric_name=cpu.utilization
    # :viz valueSuffix=%
    # :return: detect block that triggers when nodes CPU utilization is above threshold
    scope_filter = utils.merge_filters(NODE_FILTER, filter_)
    group_by = [k8s_utils.K8S_CLUSTER_NAME_DIM, k8s_utils.K8S_NODE_NAME_DIM]
    stream = data('cpu.utilization', filter=scope_filter).mean(by=group_by)
    fire_threshold_stream = const(fire_threshold)
    ann = [utils.annotate_stream(stream, 'CPU utilization'),
           utils.annotate_fire_threshold(fire_threshold_stream, orientation='above')]
    return detect(when(stream > fire_threshold_stream, lasting=fire_lasting),
                  off=when(stream <= fire_threshold_stream, lasting=clear_lasting),
                  annotations=ann,
                  auto_resolve_after=utils.AUTO_RESOLVE_AFTER)


def node_disk_memory_pid_pressure_detector(filter_: filter = None):
    # Detects when K8s Node condition is one of DiskPressure, MemoryPressure, PIDPressure for 15 minutes
    # :param filter_ description=Specifies dimensional scope of the detector
    # :param filter_ metric_name=k8s.node.condition
    # :return: detect block that triggers when Node is under disk/memory/PID pressure for 15 minutes
    group_by = [k8s_utils.K8S_CLUSTER_NAME_DIM,
                k8s_utils.K8S_NODE_NAME_DIM,
                "condition"]
    condition_filter = filter('condition', 'DiskPressure', 'MemoryPressure', 'PIDPressure')
    scope_filter = utils.merge_filters(condition_filter, filter_)
    stream = data('k8s.node.condition', filter=scope_filter).sum(by=group_by).publish('Node condition')
    return detect(when(stream == 1, lasting=lasting('15m', 0.9)),
           off=when(stream != 1, lasting=lasting('20m', 1)),
           auto_resolve_after=utils.AUTO_RESOLVE_AFTER)
