from signalfx.detectors.autodetect.infra.k8s import utils as k8s_utils

def _resource_not_at_spec_blended(stream: stream, desired: stream, headroom: float):
    missing = stream.publish('Missing')
    missing_today = missing.percentile(pct=80, over='12h')
    missing_yesterday = missing.timeshift('23h').percentile(pct=80, over='2h')
    missing_weekago = missing_yesterday.timeshift('6d')
    alert_level = min(max(missing_today, missing_yesterday, missing_weekago) * headroom, desired)
    ann = [annotate(alert_level, 'upper fire threshold', {
        'sfui_streamType': 'threshold','sfui_state':'fire','sfui_orientation':'above'})]
    # NOTE Alert when missing >= threshold(alert_level) means alerting when all pods are missing regardless of 
    # historical values (not desirable); missing > threshold(alert_level) means it is possible that no alert is raised
    # even if all pods are missing
    return detect(
        when(missing > threshold(alert_level), lasting=lasting('15m', 0.8)),
        off=when(missing <= threshold(alert_level), lasting=lasting('40m', 0.9)),
        annotations=ann,
        auto_resolve_after=duration('1d')
    )

def deployment_not_at_spec_blended_detector(headroom: float = 1, filter_: filter = None):
    # Detects when the number of missing pods for the deployment increases, compared to historical values
    # :param headroom label=Headroom multiplier (unitless; 1.0-2.0)
    # :param headroom description=How much worse the number of missing pods must be, compared to historical, in order to trigger an alert.
    # :param headroom control_type=slider
    # :param headroom min=0
    # :param headroom max=2
    # :param headroom step_count=5
    # :param filter_ description=Specifies dimensional scope of the detector
    # :param filter_ metric_name=k8s.deployment.desired
    # :return: detect block that triggers when number of missing pods for the deployment increases.
    group_by = [k8s_utils.K8S_NAMESPACE_NAME_DIM,
                k8s_utils.K8S_CLUSTER_NAME_DIM,
                k8s_utils.K8S_DEPLOYMENT_NAME_DIM]
    desired_stream = data('k8s.deployment.desired', filter=filter_).sum(by=group_by, allow_missing=group_by)
    available_stream = data('k8s.deployment.available', filter=filter_).sum(by=group_by, allow_missing=group_by)
    stream = (desired_stream - available_stream)
    return _resource_not_at_spec_blended(stream=stream,
                                         desired=desired_stream,
                                         headroom=headroom)

def daemonset_not_at_spec_blended_detector(headroom: float = 1, filter_: filter = None):
    # Detects when the number of missing nodes running the daemon pod for the daemonset increases, compared to historical values
    # :param headroom label=Headroom multiplier (unitless; 1.0-2.0)
    # :param headroom description=How much worse the number of missing nodes must be, compared to historical, in order to trigger an alert.
    # :param headroom control_type=slider
    # :param headroom min=0
    # :param headroom max=2
    # :param headroom step_count=5
    # :param filter_ description=Specifies dimensional scope of the detector
    # :param filter_ metric_name=k8s.daemonset.desired_scheduled_nodes
    # :return: detect block that triggers when number of missing nodes for the daemonset increases.
    group_by = [k8s_utils.K8S_NAMESPACE_NAME_DIM,
                k8s_utils.K8S_CLUSTER_NAME_DIM,
                k8s_utils.K8S_DAEMONSET_NAME_DIM]
    desired_stream = data('k8s.daemonset.desired_scheduled_nodes', filter=filter_).sum(by=group_by, allow_missing=group_by)
    available_stream = data('k8s.daemonset.ready_nodes', filter=filter_).sum(by=group_by, allow_missing=group_by)
    stream = (desired_stream - available_stream)
    return _resource_not_at_spec_blended(stream=stream,
                                         desired=desired_stream,
                                         headroom=headroom)

def statefulset_not_at_spec_blended_detector(headroom: float = 1, filter_: filter = None):
    # Detects when the number of missing pods for the statefulset increases, compared to historical values
    # :param headroom label=Headroom multiplier (unitless; 1.0-2.0)
    # :param headroom description=How much worse the number of missing pods must be, compared to historical, in order to trigger an alert.
    # :param headroom control_type=slider
    # :param headroom min=0
    # :param headroom max=2
    # :param headroom step_count=5
    # :param filter_ description=Specifies dimensional scope of the detector
    # :param filter_ metric_name=k8s.statefulset.desired_pods
    # :return: detect block that triggers when number of missing pods for the daemonset increases.
    group_by = [k8s_utils.K8S_NAMESPACE_NAME_DIM,
                k8s_utils.K8S_CLUSTER_NAME_DIM,
                k8s_utils.K8S_STATEFULSET_NAME_DIM]
    desired_stream = data('k8s.statefulset.desired_pods', filter=filter_).sum(by=group_by, allow_missing=group_by)
    available_stream = data('k8s.statefulset.ready_pods', filter=filter_).sum(by=group_by, allow_missing=group_by)
    stream = (desired_stream - available_stream)
    return _resource_not_at_spec_blended(stream=stream,
                                         desired=desired_stream,
                                         headroom=headroom)
